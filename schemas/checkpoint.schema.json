{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rot.dev/schemas/checkpoint.v1.json",
  "title": "Agent Survival Checkpoint v1",
  "type": "object",
  "required": ["checkpoint_id","timestamp","project_id","workstream_id","objective_id","agent_id","session_id","head_sha","event_watermark","authority","completed","tests","blockers","graph_delta","task_delta","next_actions","resume_recipe"],
  "properties": {
    "checkpoint_id":{"type":"string","minLength":8},
    "parent_checkpoint_id":{"type":["string","null"]},
    "timestamp":{"type":"string","format":"date-time"},
    "project_id":{"type":"string"},
    "workstream_id":{"type":"string"},
    "objective_id":{"type":"string"},
    "agent_id":{"type":"string"},
    "session_id":{"type":"string"},
    "branch":{"type":["string","null"]},
    "base_sha":{"type":["string","null"],"pattern":"^[0-9a-f]{7,40}$"},
    "head_sha":{"type":"string","pattern":"^[0-9a-f]{7,40}$"},
    "event_watermark":{"type":"string"},
    "authority":{"enum":["PROPOSED","IMPLEMENTED","EXECUTED","VERIFIED","BLOCKED"]},
    "phase":{"type":["string","null"]},
    "completed":{"type":"array","items":{"type":"string"}},
    "changed_paths":{"type":"array","items":{"type":"string"}},
    "decisions":{"type":"array","items":{"type":"string"}},
    "tests":{"type":"array","items":{"type":"object"}},
    "evidence":{"type":"array","items":{"type":"object"}},
    "blockers":{"type":"array","items":{"type":"string"}},
    "risks":{"type":"array","items":{"type":"string"}},
    "graph_delta":{"type":"object"},
    "task_delta":{"type":"object"},
    "refactor_debt":{"type":"array","items":{"type":"string"}},
    "next_actions":{"type":"array","items":{"type":"string"},"minItems":1},
    "resume_recipe":{"type":"array","items":{"type":"string"},"minItems":1}
  },
  "additionalProperties": true
}