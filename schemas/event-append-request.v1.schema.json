{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"rot://schema/event-append-request/1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","request_id","stream","expected_revision","idempotency_key","caller","traceparent","events"],
  "properties":{
    "schema_version":{"const":"event-append-request/1"},
    "request_id":{"type":"string","minLength":1},
    "stream":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","tenant_id","stream_kind","stream_id"],
      "properties":{
        "schema_version":{"const":"event-stream-key/1"},
        "tenant_id":{"type":"string","minLength":1},
        "stream_kind":{"type":"string","minLength":1},
        "stream_id":{"type":"string","pattern":"^rot:.+"}
      }
    },
    "expected_revision":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "idempotency_key":{"type":"string","minLength":1},
    "caller":{
      "type":"object","additionalProperties":false,
      "required":["caller_id","tenant_id","allowed_sensitivities"],
      "properties":{
        "caller_id":{"type":"string","minLength":1},
        "tenant_id":{"type":"string","minLength":1},
        "allowed_sensitivities":{"type":"array","items":{"enum":["PUBLIC","INTERNAL","PRIVATE","RESTRICTED","SECRET_REF"]},"uniqueItems":true}
      }
    },
    "traceparent":{"type":["string","null"]},
    "events":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["event_id","event_type","event_schema_version","occurred_at","actor_id","subject_ids","source_record_ids","evidence_ids","correlation_id","causation_id","mission_id","sensitivity","payload","metadata"],
        "properties":{
          "event_id":{"type":"string","pattern":"^rot:event:v1:.+"},
          "event_type":{"type":"string","pattern":"^rot://event/.+"},
          "event_schema_version":{"type":"string","minLength":1},
          "occurred_at":{"type":"string","format":"date-time"},
          "actor_id":{"type":"string","minLength":1},
          "subject_ids":{"type":"array","items":{"type":"string"}},
          "source_record_ids":{"type":"array","items":{"type":"string"}},
          "evidence_ids":{"type":"array","items":{"type":"string"}},
          "correlation_id":{"type":"string","minLength":1},
          "causation_id":{"type":["string","null"]},
          "mission_id":{"type":["string","null"]},
          "sensitivity":{"enum":["PUBLIC","INTERNAL","PRIVATE","RESTRICTED","SECRET_REF"]},
          "payload":{"type":"object"},
          "metadata":{"type":"object"}
        }
      }
    }
  }
}
